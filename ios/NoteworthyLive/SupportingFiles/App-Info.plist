<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keys to add to the APP target's Info.plist. Live Activities are enabled by
  NSSupportsLiveActivities. The custom URL scheme lets Live Activity taps reopen
  the app (which then shows the web /story/<slug> page in SFSafariViewController).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>co.noteworthynews.live.deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>noteworthylive</string>
            </array>
        </dict>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
</dict>
</plist>
