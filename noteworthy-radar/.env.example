# =====================================================================
# Noteworthy Radar - environment configuration
# Copy to .env.local and fill in. The app runs WITHOUT AI keys
# (a deterministic stub provider is used automatically).
# =====================================================================

# --- Supabase (dedicated project for Noteworthy Radar) -----------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider abstraction ------------------------------------------
# AI_PROVIDER: "stub" (default, no key needed) | "openai" | "anthropic"
AI_PROVIDER=stub
# Only needed when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Only needed when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Branding / export defaults ---------------------------------------
NEXT_PUBLIC_BRAND_NAME=Noteworthy News
NEXT_PUBLIC_BRAND_HANDLE=@NoteworthyNews
# Default top label burned into vertical exports.
EXPORT_DEFAULT_TOP_LABEL=NOT REALLY THE NEWS

# --- App ---------------------------------------------------------------
# Base URL used by the capture bookmarklet to POST leads.
NEXT_PUBLIC_APP_URL=http://localhost:3100
