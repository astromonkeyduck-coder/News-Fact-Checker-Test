{
  "name": "noteworthy-news-game",
  "version": "1.0.0",
  "description": "Breaking News Fact Checker Game",
  "main": "index.html",
  "scripts": {
    "fetch-tweets": "node fetch-tweets.js",
    "start": "open index.html",
    "dev": "npx netlify dev",
    "serve": "npx netlify dev",
    "test:webhook": "ts-node scripts/simulate-webhook.ts",
    "build": "node scripts/update-last-modified.js && node scripts/inject-auth0.js && npm run minify",
    "prebuild": "node scripts/update-last-modified.js && node scripts/inject-auth0.js",
    "minify": "webpack --config webpack.config.js",
    "update-timestamp": "node scripts/update-last-modified.js",
    "test:games": "jest --testPathPattern=GamesGallery.test.js",
    "validate:games": "node scripts/validate-game-embeds.js",
    "audit:game": "node scripts/security-audit-game.js",
    "add:game": "node scripts/safe-add-game.js",
    "test:earthquake": "node test-earthquake-visual.js",
    "test:earthquake-full": "node test-full-earthquake-pipeline.js",
    "test:earthquake-last": "node test-last-earthquake.js",
    "test:video": "node test-video-generation-local.js"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.8.0",
    "@aws-sdk/client-s3": "^3.967.0",
    "@aws-sdk/s3-request-presigner": "^3.967.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@netlify/blobs": "8.2.0",
    "ffmpeg-static": "^5.2.0",
    "@netlify/functions": "^2.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.39.0",
    "gifenc": "^1.0.3",
    "heic-convert": "^1.2.4",
    "ioredis": "^5.3.2",
    "openai": "^4.20.0",
    "puppeteer": "^21.0.0",
    "resend": "^3.0.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.33.0"
  },
  "keywords": [
    "news",
    "fact-checking",
    "game",
    "media-literacy"
  ],
  "author": "Noteworthy News",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.9",
    "@types/react": "^18.2.45",
    "dotenv": "^17.2.3",
    "netlify-cli": "^23.12.3",
    "node-fetch": "^2.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "terser": "^5.44.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  }
}
